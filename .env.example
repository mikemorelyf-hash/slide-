# Core runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ride_pool
PGSSLMODE=disable
PG_POOL_MAX=6
PG_IDLE_TIMEOUT_MS=15000
PG_CONNECTION_TIMEOUT_MS=5000

# Telegram bot
BOT_TOKEN=replace_with_telegram_bot_token
DRIVER_BOT_TOKEN=replace_with_driver_bot_token
BOT_MODE=webhook
BASE_URL=https://your-railway-service.up.railway.app
WEBHOOK_PATH=/telegram/webhook
DRIVER_WEBHOOK_PATH=/telegram/driver-webhook
WEBHOOK_SECRET=replace_with_a_random_32_character_secret
DRIVER_GROUP_CHAT_ID=-1001234567890
ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=

# Pool behavior
POOL_SIZE=4
DRIVER_ARRIVAL_TIMEOUT_MINUTES=10
LATE_DRIVER_SWEEP_INTERVAL_SECONDS=60
AUTO_SEED_ROUTES=true
ROUTES=Mexico -> Bole|Mexico -> Piyasa|Mexico -> CMC|Mexico -> Hayat|Mexico -> 4 Killo|Mexico -> Megenagna

# Future Mini App / Vercel frontend
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
MINI_APP_URL=https://your-vercel-app.vercel.app
MINI_APP_INIT_DATA_MAX_AGE_SECONDS=86400
